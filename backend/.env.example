# Database Configuration
DATABASE_URL=sqlite:///./data_new.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/school_management

# Application Settings
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (Development - allows all origins)
# In production, set specific origins: ["https://yourdomain.com"]
ALLOWED_ORIGINS=["*"]

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# Email Settings (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=critical.alert@areete.ai
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=critical.alert@areete.ai
SMTP_FROM_NAME=School Management System
SMTP_USE_TLS=true
SMTP_USE_SSL=false
APP_BASE_URL=http://127.0.0.1:3001



# Redis Settings (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
